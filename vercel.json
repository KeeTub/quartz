{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/manifest.json", "destination": "/quartz/static/manifest.json" },
    { "source": "/sw.js", "destination": "/quartz/static/sw.js" },
    { "source": "/icon-192.png", "destination": "/quartz/static/icon-192.png" },
    { "source": "/icon-512.png", "destination": "/quartz/static/icon-512.png" },
    { "source": "/:path*", "destination": "/:path*" }
  ]
}
